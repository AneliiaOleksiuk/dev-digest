node_modules/
dist/
# agent-runner/dist/index.js is a build artifact (`cd agent-runner && pnpm build`),
# read from disk at export time and embedded into the TARGET repo as
# .devdigest/runner/index.js — it is never committed to this repository.
# agent-runner/.gitignore:2 (`dist/`) is the rule that actually keeps it
# untracked (confirmed via `git check-ignore -v`); the negation below never
# re-included anything by itself (it only re-opens traversal into the
# directory, and the nested .gitignore's `dist/` re-excludes it anyway) — its
# now-redundant `!agent-runner/dist/**` follow-up line was removed as dead
# weight rather than kept as a misleading no-op.
!agent-runner/dist/
build/
.next/
out/
coverage/
*.tsbuildinfo
.env
.env.local
.DS_Store
.idea/
.turbo/
.pnpm-store/
*.log
.devdigest/cache/
clones/
playwright-report/
test-results/

# emdash worktree config (local)
.emdash.json
.claude/settings.local.json

# skill-creator's own scratch benchmark/iteration runs (evals/ has the tracked harness instead)
.claude/skills/*-workspace/

# pr-description skill-creator fixtures are real nested git repos (the eval needs an actual
# `git diff` inside them) — git can't track a nested .git as plain files, only as a broken
# gitlink with no remote. Left untracked pending a patch-file-based fixture format.
.claude/skills/pr-description/evals/fixtures/case-1-ratelimiter-fix/
.claude/skills/pr-description/evals/fixtures/case-2-ui-spinner/
.claude/skills/pr-description/evals/fixtures/case-3-adversarial-gate/
.claude/settings.local.json
